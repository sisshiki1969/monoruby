#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates monoruby/src/value/rvalue/string/transcode/kddi.rs from CRuby: the
# cells stateless-ISO-2022-JP-KDDI (and so ISO-2022-JP-KDDI) spells the
# KDDI emoji in, which are rows JIS X 0208 does not have (0xF5..0xFB in
# EUC form), and the few characters it writes into another cell than
# CP51932 does. Like bin/gen-carrier-tables it needs no monoruby
# baseline: everything else in the encoding is CP51932's.
#
#   bin/gen-kddi-iso2022-table > monoruby/src/value/rvalue/string/transcode/kddi.rs

enc = []
(0xE000..0xF8FF).each do |cp|
  s = [cp].pack("U").force_encoding("UTF8-KDDI")
  b = (s.encode("stateless-ISO-2022-JP-KDDI").bytes rescue next)
  next unless b.size == 3 && b[0] == 0x92
  enc << [cp, (b[1] << 8) | b[2]]
end
dec = []
(0xA1..0xFE).each do |b1|
  (0xA1..0xFE).each do |b2|
    s = [0x92, b1, b2].pack("C*").force_encoding("stateless-ISO-2022-JP-KDDI")
    cps = (s.encode("UTF8-KDDI").codepoints rescue next)
    next unless cps.size == 1 && cps[0].between?(0xE000, 0xF8FF)
    dec << [(b1 << 8) | b2, cps[0]]
  end
end
# Where this encoding writes a character CP51932 also has into a
# different cell: the duplicates JIS X 0208 and NEC row 13 both hold,
# which CP51932 writes into the JIS cell and this encoding into the
# NEC one. (A character CP51932 lacks and this encoding spells — a
# Unicode emoji — reaches its cell through UTF8-KDDI, not this table.)
prefer = []
(0x80..0xFFFF).each do |cp|
  next if (0xD800..0xDFFF).cover?(cp) || (0xE000..0xF8FF).cover?(cp)
  ch = [cp].pack("U")
  b = (ch.encode("CP51932").bytes rescue next)
  a = (ch.encode("stateless-ISO-2022-JP-KDDI").bytes rescue next)
  next if a.size != 3 || a[1..] == b
  prefer << [cp, (a[1] << 8) | a[2]]
end

puts "//! Generated by bin/gen-kddi-iso2022-table from CRuby #{RUBY_VERSION}. Do not edit."
puts "//!"
puts "//! The KDDI emoji as stateless-ISO-2022-JP-KDDI spells them: the"
puts "//! private-use character UTF8-KDDI gives each one, and the cell (the"
puts "//! two EUC-style bytes after the 0x92 lead) it lives in. Two"
puts "//! private-use characters can share a cell, which reads back as the"
puts "//! one CRuby's table lists first. And the characters CP51932 holds"
puts "//! twice, which this encoding writes into the other cell."
puts
puts "/// Character to cell, sorted by character."
puts "pub(crate) static KDDI_ISO2022_ENCODE: [(u32, u16); #{enc.size}] = ["
enc.sort.each_slice(6) { |row| puts "    " + row.map { |cp, c| format("(0x%04x, 0x%04x),", cp, c) }.join(" ") }
puts "];"
puts
puts "/// Cell to character, sorted by cell."
puts "pub(crate) static KDDI_ISO2022_DECODE: [(u16, u32); #{dec.size}] = ["
dec.sort.each_slice(6) { |row| puts "    " + row.map { |c, cp| format("(0x%04x, 0x%04x),", c, cp) }.join(" ") }
puts "];"
puts
puts "/// Character to cell where CP51932's cell for it is another, sorted by character."
puts "pub(crate) static KDDI_ISO2022_PREFER: [(u32, u16); #{prefer.size}] = ["
prefer.sort.each_slice(6) { |row| puts "    " + row.map { |cp, c| format("(0x%04x, 0x%04x),", cp, c) }.join(" ") }
puts "];"
