#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates monoruby/src/value/rvalue/string/transcode/cjk.rs from CRuby's own
# tables. These encodings change about as often as the standards they
# spell, so the output is checked in rather than built.
#
#   cargo build --features no-cjk-tables
#   MONORUBY=target/debug/monoruby bin/gen-cjk-tables \
#       > monoruby/src/value/rvalue/string/transcode/cjk.rs
#   cargo build
#
# `live` is read from CRuby alone: the set of cells its table holds,
# and the bulk of the correction. The override lists say where CRuby
# and `encoding_rs` both have a cell and disagree about it, so they
# are diffed against a monoruby answering from the codec alone —
# which is what the `no-cjk-tables` feature builds. Pointing MONORUBY
# at an ordinary build would diff the tables against themselves and
# silently emit empty override lists.

SPECS = {
  "GB2312"  => { rust: "GB2312",  lead: 0xA1..0xFE, trail: 0xA1..0xFE },
  "GBK"     => { rust: "GBK",     lead: 0x81..0xFE, trail: 0x40..0xFE },
  "Big5"    => { rust: "BIG5",    lead: 0x81..0xFE, trail: 0x40..0xFE },
  # GB18030 has a cell for everything, so it restricts none and gets
  # no `live` grid — but it still reads and writes some of them
  # differently, so it keeps both override lists.
  "GB18030" => { rust: "GB18030", lead: 0x81..0xFE, trail: 0x40..0xFE, grid: false },
  # Microsoft's Big5, which is not CRuby's Big5: it fills thousands of
  # cells Big5 leaves empty (mostly with private-use characters) and
  # its encoder carries best-fit mappings, which are the single-byte
  # cells below (#1567).
  "CP950"   => { rust: "CP950",   lead: 0x81..0xFE, trail: 0x40..0xFE },
  "CP951"   => { rust: "CP951",   lead: 0x81..0xFE, trail: 0x40..0xFE },
  # Big5-HKSCS and Big5-UAO read through `encoding_rs`'s `big5` (the
  # HKSCS-2008 table) as Big5 does: HKSCS differs from it in a handful
  # of cells, UAO in thousands, and both fill rows below 0xA1 that
  # CRuby's Big5 leaves empty (#1500, #1520).
  "Big5-HKSCS" => { rust: "BIG5_HKSCS", lead: 0x81..0xFE, trail: 0x40..0xFE },
  "Big5-UAO"   => { rust: "BIG5_UAO",   lead: 0x81..0xFE, trail: 0x40..0xFE },
  # GB12345 is GB2312's grid filled with the traditional forms, read
  # through `gbk` like GB2312 (#1520).
  "GB12345" => { rust: "GB12345", lead: 0xA1..0xFE, trail: 0xA1..0xFE },
}

def cells(enc, spec)
  out = {}
  spec[:lead].each do |b1|
    spec[:trail].each do |b2|
      next if b2 == 0x7F
      s = [b1, b2].pack("C*").force_encoding(enc)
      cp = (s.encode("UTF-8").codepoints[0] rescue nil)
      out[(b1 << 8) | b2] = cp if cp
    end
  end
  out
end

# The bytes CRuby writes for each character it can encode.
def chars(enc)
  out = {}
  (0x80..0x10FFFF).each do |cp|
    next if cp.between?(0xD800, 0xDFFF)
    s = ([cp].pack("U") rescue next)
    b = (s.encode(enc) rescue next)
    out[cp] = b.bytes
  end
  out
end

MONORUBY = ENV["MONORUBY"] || "target/debug/monoruby"

# What the codec alone answers, as `-e` scripts run by that build. The
# encode sweep walks the whole scalar range for each encoding, so this
# is minutes rather than seconds.
def mono_dump(script)
  unless File.executable?(MONORUBY)
    abort "MONORUBY=#{MONORUBY} is not executable; " \
          "build one with `cargo build --features no-cjk-tables`"
  end
  out = IO.popen([MONORUBY, "-e", script], &:read)
  abort "#{MONORUBY} failed" unless $?.success?
  out
end

# Guard against a baseline taken from a build that already carries the
# tables: it would agree with CRuby everywhere and empty every override
# list. GB2312 has no cell for U+20AC, and a corrected build says so.
def check_baseline!
  euro = mono_dump(<<~RB).strip
    begin
      print "\\u20AC".encode("GB2312").bytes.join(",")
    rescue Encoding::UndefinedConversionError
      print "none"
    end
  RB
  return unless euro == "none"
  abort "#{MONORUBY} already corrects GB2312 (U+20AC has no cell); " \
        "build it with `cargo build --features no-cjk-tables`"
end

def mono_cells(encs)
  script = <<~RB
    #{encs.inspect}.each do |e|
      0x81.upto(0xFE) do |b1|
        0x40.upto(0xFE) do |b2|
          next if b2 == 0x7F
          s = [b1, b2].pack("C*").force_encoding(e)
          cp = (s.encode("UTF-8").codepoints[0] rescue next)
          puts [e, b1, b2, cp].join("\\t")
        end
      end
    end
  RB
  out = {}
  mono_dump(script).each_line do |l|
    e, b1, b2, cp = l.chomp.split("\t")
    (out[e] ||= {})[(b1.to_i << 8) | b2.to_i] = cp.to_i
  end
  out
end

def mono_chars(encs)
  script = <<~RB
    #{encs.inspect}.each do |e|
      0x80.upto(0x10FFFF) do |cp|
        next if cp.between?(0xD800, 0xDFFF)
        s = ([cp].pack("U") rescue next)
        b = (s.encode(e) rescue next)
        puts [e, cp, b.bytes.join(",")].join("\\t")
      end
    end
  RB
  out = {}
  mono_dump(script).each_line do |l|
    e, cp, bs = l.chomp.split("\t")
    (out[e] ||= {})[cp.to_i] = bs.split(",").map(&:to_i)
  end
  out
end

puts <<~HEAD
  //! Generated by bin/gen-cjk-tables from CRuby #{RUBY_VERSION}. Do not edit.
  //!
  //! CRuby's tables for the CJK double-byte encodings, as the
  //! corrections `encoding_rs` needs to answer the way CRuby does.
  //!
  //! `LIVE` is the set of cells CRuby's table holds, a bit per cell of
  //! the encoding's lead × trail grid. `encoding_rs` carries WHATWG's
  //! tables, which are wider — its `gb2312` is GBK and its `big5`
  //! reaches rows CRuby has nothing in — so a cell outside this set is
  //! one the encoding does not have, on the way in and on the way out
  //! alike.
  //!
  //! The override lists are the cells both sides have and read or
  //! write differently.
HEAD

puts <<~STRUCT

  /// One encoding's table, as the difference from the codec that
  /// stands in for it.
  pub(crate) struct CellTable {
      /// The lead and trail ranges the grid covers.
      pub(crate) lead: (u8, u8),
      pub(crate) trail: (u8, u8),
      /// A bit per cell of that grid: set when CRuby's table holds it.
      /// Empty when the encoding restricts no cell.
      pub(crate) live: &'static [u8],
      /// Cells CRuby reads as something else.
      pub(crate) decode: &'static [(u16, u32)],
      /// Characters CRuby writes elsewhere. The value packs the bytes
      /// big-endian, and their number follows from it: a lead is
      /// never below `0x81`, so a value below `0x100` is one byte
      /// (CP950's best-fit mappings), one below `0x1_0000` is two,
      /// and a larger one fills the word with four.
      pub(crate) encode: &'static [(u32, u32)],
      /// Characters the codec writes and CRuby's table has no cell
      /// for. Its tables are many-to-one on the way in, so a cell can
      /// read back as one of these without being what CRuby writes
      /// for it.
      pub(crate) reject: &'static [u32],
  }

  impl CellTable {
      /// Whether CRuby's table holds *cell*.
      pub(crate) fn holds(&self, cell: u16) -> bool {
          if self.live.is_empty() {
              return true;
          }
          let (b1, b2) = ((cell >> 8) as u8, cell as u8);
          if b1 < self.lead.0 || b1 > self.lead.1 || b2 < self.trail.0 || b2 > self.trail.1 {
              return false;
          }
          let span = self.trail.1 as usize - self.trail.0 as usize + 1;
          let at = (b1 as usize - self.lead.0 as usize) * span + (b2 as usize - self.trail.0 as usize);
          self.live[at / 8] & (1 << (at % 8)) != 0
      }

      /// The character CRuby reads *cell* as, when that differs from
      /// what the codec would say.
      pub(crate) fn read(&self, cell: u16) -> Option<char> {
          let i = self.decode.binary_search_by_key(&cell, |e| e.0).ok()?;
          char::from_u32(self.decode[i].1)
      }

      /// Whether CRuby writes *c* nowhere, though the codec writes it
      /// into a cell CRuby's table does have.
      pub(crate) fn refuses(&self, c: char) -> bool {
          self.reject.binary_search(&(c as u32)).is_ok()
      }

      /// The bytes CRuby writes for *c*, when those differ.
      pub(crate) fn write(&self, c: char) -> Option<Vec<u8>> {
          let i = self.encode.binary_search_by_key(&(c as u32), |e| e.0).ok()?;
          let packed = self.encode[i].1;
          Some(if packed < 0x100 {
              vec![packed as u8]
          } else if packed < 0x1_0000 {
              vec![(packed >> 8) as u8, packed as u8]
          } else {
              packed.to_be_bytes().to_vec()
          })
      }
  }
STRUCT

def bitset(live, spec)
  return [] unless spec.fetch(:grid, true)
  span = spec[:trail].last - spec[:trail].first + 1
  n = (spec[:lead].last - spec[:lead].first + 1) * span
  bytes = Array.new((n + 7) / 8, 0)
  live.each_key do |cell|
    b1 = cell >> 8
    b2 = cell & 0xFF
    at = (b1 - spec[:lead].first) * span + (b2 - spec[:trail].first)
    bytes[at / 8] |= 1 << (at % 8)
  end
  bytes
end

def fmt_bytes(name, bytes)
  out = +"static #{name}: [u8; #{bytes.size}] = [\n"
  bytes.each_slice(16) { |row| out << "    " << row.map { |b| format("0x%02x,", b) }.join(" ") << "\n" }
  out << "];\n"
end

def fmt_pairs(name, ty, pairs, fmt)
  return "static #{name}: [#{ty}; 0] = [];\n" if pairs.empty?
  out = +"static #{name}: [#{ty}; #{pairs.size}] = [\n"
  pairs.each_slice(4) { |row| out << "    " << row.map(&fmt).join(" ") << "\n" }
  out << "];\n"
end

check_baseline!
mono_dec = mono_cells(SPECS.keys)
mono_enc = mono_chars(SPECS.keys)

SPECS.each do |enc, spec|
  # `bitset` drops this for an encoding with no grid, which then
  # restricts no cell; the override lists are read off it either way.
  live = cells(enc, spec)
  ch = chars(enc)
  md = mono_dec[enc] || {}
  me = mono_enc[enc] || {}
  dec = live.reject { |c, cp| md[c] == cp }
  # A character CRuby writes into a cell its table does not *read* —
  # Big5-HKSCS writes U+20AC as `A3 E1` and refuses those bytes on the
  # way in — is recorded even where the codec writes the same bytes:
  # the reader takes a codec's cell only when the table holds it, so
  # the write has to be spelled out to survive that check.
  encv = ch.reject { |cp, bs|
    me[cp] == bs && !(bs.size == 2 && spec.fetch(:grid, true) && !live.key?((bs[0] << 8) | bs[1]))
  }
  # `write` reads the byte count back off the packed word, which works
  # only for one, two or four bytes, and only while no two-byte cell
  # has a lead below 0x81 (which would collide with the one-byte form).
  encv.each_value do |bs|
    abort "#{enc}: cannot pack a #{bs.size}-byte cell" unless [1, 2, 4].include?(bs.size)
    abort "#{enc}: a two-byte cell leads with #{bs[0]}" if bs.size == 2 && bs[0] < 0x81
  end
  # Characters the codec writes that CRuby's table has no cell for.
  # A cell outside `live` is refused by that alone, so only the ones
  # whose cell CRuby does have — its tables are many-to-one on the way
  # in — need naming here.
  rej = if !spec.fetch(:grid, true)
          []
        else
          (me.keys - ch.keys).reject { |cp|
            bs = me[cp]
            bs.size == 2 && !live.key?((bs[0] << 8) | bs[1])
          }.sort
        end
  puts
  puts fmt_bytes("#{spec[:rust]}_LIVE", bitset(live, spec))
  puts fmt_pairs("#{spec[:rust]}_DECODE", "(u16, u32)", dec.sort.to_a,
                 ->(e) { format("(0x%04x, 0x%04x),", e[0], e[1]) })
  puts fmt_pairs("#{spec[:rust]}_ENCODE", "(u32, u32)", encv.sort.to_a,
                 ->(e) { format("(0x%04x, 0x%s),", e[0], e[1].map { |b| format("%02x", b) }.join) })
  puts fmt_pairs("#{spec[:rust]}_REJECT", "u32", rej, ->(cp) { format("0x%04x,", cp) })
  puts <<~TAB
    pub(crate) static #{spec[:rust]}: CellTable = CellTable {
        lead: (0x#{spec[:lead].first.to_s(16)}, 0x#{spec[:lead].last.to_s(16)}),
        trail: (0x#{spec[:trail].first.to_s(16)}, 0x#{spec[:trail].last.to_s(16)}),
        live: &#{spec[:rust]}_LIVE,
        decode: &#{spec[:rust]}_DECODE,
        encode: &#{spec[:rust]}_ENCODE,
        reject: &#{spec[:rust]}_REJECT,
    };
  TAB
end
