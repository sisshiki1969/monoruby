#!/bin/bash
# Install monoruby: the binary and the dynamically loaded extensions
# (doc/native_extension_loading.md §7), in one `cargo install`. The
# extensions are artifact dependencies of the interpreter, so Cargo builds
# them and `build.rs` puts them in the install root's `ext/`, where the
# installed binary looks for them after its own directory — rubygems needs
# `require "zlib"` to read a `.gem` at all.
#
# So `cargo install --path monoruby` on its own is enough. This script adds
# two things: MONORUBY_SYSTEM_LIBS (below), and a `cd` to the repository
# root — from outside it the nightly in rust-toolchain.toml does not apply
# and the artifact dependencies fail on `-Z bindeps`.
#
# For an install that does not depend on this machine's home directory
# (the install root's absolute path is baked into the binary), see
# `bin/dist`, which stages a relocatable tree and can tar it up.
#
#   bin/install            # release build, ~/.cargo/bin/monoruby
#   bin/install --debug    # debug build (slower binary, faster build)
#
# MONORUBY_SYSTEM_LIBS names the extensions to link against the platform's
# shared library instead of the copy they vendor — a space-separated list
# of "sqlite3", "zlib" and "zstd", or "all" for those three:
#
#   MONORUBY_SYSTEM_LIBS=all bin/install
#   MONORUBY_SYSTEM_LIBS="zlib zstd" bin/install
#
# psych takes no such option (libyaml-safer is a Rust port, so there is no
# bundled C library to replace) and neither does nokogiri (its libxml2
# carries nokogiri's patches, and the FFI mirrors that version's struct
# layouts). See doc/native_extension_loading.md.
set -e
cd "$(dirname "$0")/.."

INSTALL_ARGS=()
if [ "${1:-}" = "--debug" ]; then
  INSTALL_ARGS=(--debug)
fi

# The extensions whose Cargo manifest offers a `system` build.
SYSTEM_CAPABLE=(sqlite3 zlib zstd)

SYSTEM_LIBS="${MONORUBY_SYSTEM_LIBS:-}"
if [ "$SYSTEM_LIBS" = "all" ]; then
  SYSTEM_LIBS="${SYSTEM_CAPABLE[*]}"
fi
for want in $SYSTEM_LIBS; do
  case " ${SYSTEM_CAPABLE[*]} " in
    *" $want "*) ;;
    *)
      echo "bin/install: MONORUBY_SYSTEM_LIBS: no system build for '$want'" >&2
      echo "             (one of: ${SYSTEM_CAPABLE[*]}, or all)" >&2
      exit 1
      ;;
  esac
done

# Selecting the platform's library is a Cargo feature on `monoruby` now
# (`system-zlib` and its `bundled-…` twins), because `cargo install` is
# what builds the extensions: they are artifact dependencies of the
# interpreter, and `build.rs` installs them. Features only ever add, so
# the whole set has to be spelled out against --no-default-features.
FEATURE_ARGS=()
if [ -n "$SYSTEM_LIBS" ]; then
  FEATURES=""
  for ext in "${SYSTEM_CAPABLE[@]}"; do
    case " $SYSTEM_LIBS " in
      *" $ext "*) FEATURES="$FEATURES,system-$ext" ;;
      *) FEATURES="$FEATURES,bundled-$ext" ;;
    esac
  done
  FEATURE_ARGS=(--no-default-features --features "${FEATURES#,}")
  echo "linking against the platform's library for: $SYSTEM_LIBS"
fi

# One command: `cargo install` builds the binary *and*, through the
# artifact dependencies in monoruby/Cargo.toml, the five extensions —
# which `build.rs` puts in the install root's `ext/`, where the installed
# binary looks for them.
cargo install --path monoruby "${INSTALL_ARGS[@]}" "${FEATURE_ARGS[@]}"

# The per-version install root build.rs populated (`MONORUBY_INSTALL_ROOT`,
# see `globals::install_root`); the installed binary reports it.
VERSION=$(sed -n 's/^version = "\(.*\)"/\1/p' monoruby/Cargo.toml | head -1)
ROOT="${MONORUBY_INSTALL_ROOT:-$HOME/.monoruby/v$VERSION}"
echo "installed $(command -v monoruby) and the extensions in $ROOT/ext"
