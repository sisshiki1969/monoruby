#!/bin/bash
# Install monoruby with `cargo install`. The dynamically loaded extensions
# (doc/native_extension_loading.md) come with it: they are artifact
# build-dependencies of monoruby, and its build.rs copies them into the
# install root's `ext/`, where the installed binary looks for them after its
# own directory. So a plain `cargo install --path monoruby` is enough; this
# script adds the choice of C libraries and a debug install.
#
#   bin/install            # release build, ~/.cargo/bin/monoruby
#   bin/install --debug    # debug build (slower binary, faster build)
#
# MONORUBY_SYSTEM_LIBS names the extensions to link against the platform's
# shared library instead of the copy they vendor — a space-separated list
# of "sqlite3", "zlib" and "zstd", or "all" for those three:
#
#   MONORUBY_SYSTEM_LIBS=all bin/install
#   MONORUBY_SYSTEM_LIBS="zlib zstd" bin/install
#
# It maps onto monoruby's `bundled-*` / `system-*` features. psych takes no
# such option (libyaml-safer is a Rust port, so there is no bundled C
# library to replace) and neither does nokogiri (its libxml2 carries
# nokogiri's patches, and the FFI mirrors that version's struct layouts).
# See doc/native_extension_loading.md.
set -e
cd "$(dirname "$0")/.."

DEBUG=
INSTALL_ARGS=()
if [ "${1:-}" = "--debug" ]; then
  DEBUG=1
  INSTALL_ARGS=(--debug)
fi

EXTENSIONS=(sqlite3 zlib zstd psych nokogiri)
# The ones with a `bundled-*` / `system-*` feature pair.
SYSTEM_CAPABLE=(sqlite3 zlib zstd)

SYSTEM_LIBS="${MONORUBY_SYSTEM_LIBS:-}"
if [ "$SYSTEM_LIBS" = "all" ]; then
  SYSTEM_LIBS="${SYSTEM_CAPABLE[*]}"
fi
for want in $SYSTEM_LIBS; do
  case " ${SYSTEM_CAPABLE[*]} " in
    *" $want "*) ;;
    *)
      echo "bin/install: MONORUBY_SYSTEM_LIBS: no system build for '$want'" >&2
      echo "             (one of: ${SYSTEM_CAPABLE[*]}, or all)" >&2
      exit 1
      ;;
  esac
done

# `system-*` has to come with --no-default-features: Cargo features only
# ever add, so the default `bundled-*` would otherwise still be selected.
FEATURES=()
for ext in "${SYSTEM_CAPABLE[@]}"; do
  case " $SYSTEM_LIBS " in
    *" $ext "*)
      echo "building ${ext}_native against the platform's library"
      FEATURES+=("system-$ext")
      ;;
    *) FEATURES+=("bundled-$ext") ;;
  esac
done
if [ -n "$SYSTEM_LIBS" ]; then
  INSTALL_ARGS+=(--no-default-features --features "$(IFS=,; echo "${FEATURES[*]}")")
fi
cargo install --path monoruby "${INSTALL_ARGS[@]}"

VERSION=$(sed -n 's/^version = "\(.*\)"/\1/p' monoruby/Cargo.toml | head -1)
ROOT="${MONORUBY_INSTALL_ROOT:-$HOME/.monoruby/v$VERSION}"

# build.rs installs the extensions from a release build only (a dev build
# must not replace an installed binary's optimized libraries), so a debug
# install copies its own.
if [ -n "$DEBUG" ]; then
  for ext in "${EXTENSIONS[@]}"; do
    case " $SYSTEM_LIBS " in
      *" $ext "*) cargo build -p "${ext}_native" --no-default-features --features system ;;
      *) cargo build -p "${ext}_native" ;;
    esac
  done
  mkdir -p "$ROOT/ext"
  case "$(uname -s)" in
    Darwin) EXT=dylib ;;
    *) EXT=so ;;
  esac
  for ext in "${EXTENSIONS[@]}"; do
    cp "target/debug/lib${ext}_native.$EXT" "$ROOT/ext/"
  done
fi
echo "installed $(command -v monoruby) and the extensions in $ROOT/ext"
