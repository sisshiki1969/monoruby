#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates monoruby/src/builtins/encoding_cp51932.rs from CRuby:
# where CP51932 parts from EUC-JP inside the two-byte plane. CP51932 is
# Windows-31J's table in EUC form, so it has NEC row 13 and the
# NEC-selected IBM extension rows (0xAD and 0xF9..0xFC), which EUC-JP
# does not, and it spells the seven cells Windows-31J and JIS disagree
# on (`A1 C1` is U+FF5E, not U+301C) the Windows way. Like
# bin/gen-kddi-iso2022-table it needs no monoruby baseline.
#
#   bin/gen-cp51932-table > monoruby/src/builtins/encoding_cp51932.rs

EXT_ROWS = [0xAD, 0xF9, 0xFA, 0xFB, 0xFC].freeze

# The cells EUC-JP does not have: the whole of the extension rows.
dec = []
EXT_ROWS.each do |r|
  (0xA1..0xFE).each do |c|
    s = [r, c].pack("C*").force_encoding("CP51932")
    u = (s.encode("UTF-8") rescue next)
    dec << [[r, c], u.ord]
  end
end

# Every character CP51932 writes into a cell EUC-JP does not write it
# into, and every character EUC-JP writes that CP51932 refuses.
enc = []
reject = []
(0x80..0xFFFF).each do |cp|
  next if (0xD800..0xDFFF).cover?(cp)
  ch = cp.chr("UTF-8")
  a = (ch.encode("EUC-JP").bytes rescue nil)
  b = (ch.encode("CP51932").bytes rescue nil)
  next if a == b
  if b
    raise "CP51932 wrote #{b.inspect} for U+#{'%04X' % cp}" unless b.size == 2
    enc << [cp, b]
  elsif a && a[0] != 0x8F
    # A JIS X 0212 character refused is the plane's absence, not a
    # cell's; the fixup says so with `second_plane: false`.
    reject << cp
  end
end
# The characters `encoding_rs` writes into a JIS X 0201 position or a
# twin cell, which EUC-JP's fixup already refuses (see EUCJP_FIXUP):
# still refused here unless CP51932 has a cell for them.
%w[2225 FF0D FF5E FFE0 FFE1 FFE2 A5 203E].map { |h| h.hex }.each do |cp|
  next if enc.any? { |c, _| c == cp } || reject.include?(cp)
  reject << cp if (cp.chr("UTF-8").encode("CP51932") rescue nil).nil?
end

puts "//! Generated by bin/gen-cp51932-table from CRuby #{RUBY_VERSION}. Do not edit."
puts "//!"
puts "//! Where CP51932 parts from EUC-JP: the NEC row 13 and NEC-selected"
puts "//! IBM extension cells (0xAD, 0xF9..0xFC) EUC-JP does not have, the"
puts "//! characters that write into them or into a cell EUC-JP spells"
puts "//! differently, and the characters EUC-JP has a cell for that"
puts "//! CP51932 refuses."
puts
puts "/// Extension cell to character, sorted by cell."
puts "pub(crate) static CP51932_DECODE: [(&[u8], char); #{dec.size}] = ["
dec.sort.each_slice(3) { |row| puts "    " + row.map { |(r, c), cp| format("(&[0x%02x, 0x%02x], '\\u{%04x}'),", r, c, cp) }.join(" ") }
puts "];"
puts
puts "/// Character to cell where it is not EUC-JP's, sorted by character."
puts "pub(crate) static CP51932_ENCODE: [(char, &[u8]); #{enc.size}] = ["
enc.sort.each_slice(3) { |row| puts "    " + row.map { |cp, (r, c)| format("('\\u{%04x}', &[0x%02x, 0x%02x]),", cp, r, c) }.join(" ") }
puts "];"
puts
puts "/// Characters with no cell, sorted."
puts "pub(crate) static CP51932_REJECT: [char; #{reject.size}] = ["
reject.sort.each_slice(6) { |row| puts "    " + row.map { |cp| format("'\\u{%04x}',", cp) }.join(" ") }
puts "];"
