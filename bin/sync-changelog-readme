#!/usr/bin/env python3
"""Regenerate README.md's "What's New" months from docs/src/changelog.md.

`docs/src/changelog.md` is the single source of truth for the monthly
changelog. The README shows only the most recent MONTHS_IN_README month
sections, copied verbatim, between the marker comments below. Editing the
README's month text by hand is therefore pointless — edit the changelog and
run this script.

Usage:
    bin/sync-changelog-readme            # rewrite README.md in place
    bin/sync-changelog-readme --check    # exit 1 if README is out of sync
"""

import re
import sys
from pathlib import Path

MONTHS_IN_README = 2

BEGIN = "<!-- BEGIN LATEST-MONTHS: generated by bin/sync-changelog-readme; edit docs/src/changelog.md -->"
END = "<!-- END LATEST-MONTHS -->"

ROOT = Path(__file__).resolve().parent.parent
CHANGELOG = ROOT / "docs" / "src" / "changelog.md"
README = ROOT / "README.md"

# "### July 2026" — a month section header in the changelog.
MONTH_RE = re.compile(r"^### (\w+ \d{4})\s*$", re.M)


def latest_months(changelog: str, count: int) -> str:
    """The `count` newest `### <Month> <Year>` sections, verbatim, newest first."""
    starts = [m.start() for m in MONTH_RE.finditer(changelog)]
    if not starts:
        sys.exit(f"{CHANGELOG}: no '### <Month> <Year>' sections found")
    # Each section runs to the next month header, or to the next `## ` heading
    # (a year boundary), or to end of file.
    sections = []
    for i, start in enumerate(starts[:count]):
        end = starts[i + 1] if i + 1 < len(starts) else len(changelog)
        year_break = re.search(r"^## ", changelog[start:end], re.M)
        if year_break:
            end = start + year_break.start()
        sections.append(changelog[start:end].strip())
    return "\n\n".join(sections)


def main() -> int:
    check = "--check" in sys.argv[1:]

    changelog = CHANGELOG.read_text()
    readme = README.read_text()

    if BEGIN not in readme or END not in readme:
        sys.exit(f"{README}: marker comments not found; expected {BEGIN!r} and {END!r}")

    head, rest = readme.split(BEGIN, 1)
    _, tail = rest.split(END, 1)

    updated = f"{head}{BEGIN}\n\n{latest_months(changelog, MONTHS_IN_README)}\n\n{END}{tail}"

    if updated == readme:
        print(f"README.md is in sync ({MONTHS_IN_README} newest months).")
        return 0
    if check:
        print("README.md is OUT OF SYNC with docs/src/changelog.md.", file=sys.stderr)
        print("Run bin/sync-changelog-readme to regenerate it.", file=sys.stderr)
        return 1
    README.write_text(updated)
    print(f"README.md updated ({MONTHS_IN_README} newest months).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
